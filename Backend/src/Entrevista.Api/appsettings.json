{
  "ForzarHttps": true,
  "FakeStore": {
    "BaseUrl": "https://fakestoreapi.com/"
  },
  "Jwt": {
    "Issuer": "Entrevista.Api",
    "Audience": "Entrevista.Client",
    "AccessTokenMinutos": 15,
    "RefreshTokenDias": 7,
    "RefreshCookie": {
      "Nombre": "refresh_token",
      "Path": "/api/auth",
      "HttpOnly": true,
      "SameSite": "Strict",
      "Secure": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
